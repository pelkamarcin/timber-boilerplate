{
  "require-dev": {
    "squizlabs/php_codesniffer": "3.*",
    "phpunit/phpunit": "^10.0",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "require": {
    "php": ">=8.1",
    "timber/timber": "^2.0",
    "twig/twig": "^3.27.1"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "autoload": {
    "psr-4" : {
      "Site\\App\\" : "src/App/"
    },
    "classmap": [
      "src"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs"
  }
}
