<?xml version="1.0" ?>
<ruleset name="WordPress Theme Boilerplate"
         namespace="WordPress\Theme\Boilerplate">
    <!--
      Provide installation path to the WordPress Coding Standards
    -->
    <config name="installed_paths"
            value="vendor/wp-coding-standards/wpcs"/>

    <!--
      Check only files with .php extension
    -->
    <arg name="extensions"
         value="php"/>

    <arg value="-colors"/>

    <arg value="ns"/>

    <!--
      Default paths to check when phpcs is run without arguments (composer lint)
    -->
    <file>.</file>

    <!--
      Exclude from checking package managers directiories
    -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>resources/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>dist/*</exclude-pattern>
    <!--
      WooCommerce template overrides - kopie szablonow WC, nie nasz kod
    -->
    <exclude-pattern>woocommerce/*</exclude-pattern>

    <!--
      Disallow using a short array syntax
    -->
    <rule ref="Generic.Arrays.DisallowShortArraySyntax.Found">
        <type>warning</type>
    </rule>

    <!--
      Extend WordPress Coding Standard ruleset
    -->
    <rule ref="WordPress-Extra">
        <!--
          Disabled intentionally
        -->
        <exclude name="WordPress.WhiteSpace.OperatorSpacing.NoSpaceAfter"/>
        <exclude name="Squiz.WhiteSpace.SuperfluousWhitespace.EndLine"/>
        <exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound"/>
        <exclude name="WordPress.Arrays.ArrayDeclarationSpacing.NoSpaceAfterArrayOpener"/>
        <exclude name="WordPress.Arrays.ArrayDeclarationSpacing.NoSpaceBeforeArrayCloser"/>
        <!--
          Sprzeczne z PSR-4 (autoloader Site\App\ -> src/App/): nazwy plikow klas,
          brak prefiksu w nazwach klas i w namespace
        -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
        <exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedClassFound"/>
        <exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedNamespaceFound"/>
        <!--
          Sprzeczne z konwencja projektu: zmienne i wlasciwosci klas sa camelCase
          (np. $contentConfig, $themePath, $providerClass), tak samo jak nazwy klas
          i namespace'ow wykluczone wyzej. WPCS wymaga snake_case, co dla kodu
          obiektowego z PSR-4 oznaczaloby przepisanie calego src/ i tests/.
          Decyzja: zostawiamy camelCase, wykluczamy caly sniff - obejmuje kody
          VariableNotSnakeCase, PropertyNotSnakeCase, UsedPropertyNotSnakeCase
          oraz InterpolatedVariableNotSnakeCase.
          Nazwy funkcji/metod NIE sa wykluczone - tam obowiazuje snake_case
          (patrz WordPress.NamingConventions.ValidFunctionName, wlaczony).
        -->
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <!--
          AGENTS.md deklaruje wprost: "WordPress coding standards (4 spaces,
          Yoda conditions opcjonalne)". Sniff wymusza Yode, wiec jest sprzeczny
          z jawna konwencja projektu - gdyby zostal wlaczony, kazdy nowy warunek
          pisany zgodnie z AGENTS.md lamalby `composer lint`.
        -->
        <exclude name="WordPress.PHP.YodaConditions"/>
        <!--
          Should be warnings
        -->
        <exclude name="WordPress.WP.EnqueuedResourceParameters.NoExplicitVersion"/>
        <exclude name="WordPress.WP.EnqueuedResources.NonEnqueuedScript"/>
        <!--
          Rules that are buggy
        -->
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
        <exclude name="WordPress.Arrays.ArrayIndentation"/>
        <!--
          Sniffy wycofane w php_codesniffer (wpcs 2.3 wciaga je przez
          WordPress-Extra i phpcs wypisuje ostrzezenie o rulesecie).
          - CallTimePassByReference: od PHP 5.4 `foo( &$bar )` to blad parsowania,
            wiec sniff nic nie moze juz zlapac. Wylaczony bez zamiennika.
          - Squiz.WhiteSpace.LanguageConstructSpacing: ma zamiennik 1:1,
            Generic.WhiteSpace.LanguageConstructSpacing, dodany ponizej.
          Do usuniecia przy podniesieniu wpcs do ^3 (wtedy znikaja z rulesetu same).
        -->
        <exclude name="Generic.Functions.CallTimePassByReference"/>
        <exclude name="Squiz.WhiteSpace.LanguageConstructSpacing"/>
    </rule>

    <!--
      Zamiennik wycofanego Squiz.WhiteSpace.LanguageConstructSpacing
    -->
    <rule ref="Generic.WhiteSpace.LanguageConstructSpacing"/>

    <!--
      Check for valid text-domains provided in the $text_domain property
    -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain"
                      type="array">
                <element value="sfy"/>
            </property>
        </properties>
    </rule>

    <!--
      Check for valid prefixes in functions names
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes"
                      type="array">
                <element value="sfy"/>
            </property>
        </properties>
    </rule>

    <!--
      Turn on theme's filenames validation
    -->
    <rule ref="WordPress.Files.FileName">
        <properties>
            <property name="is_theme"
                      value="true"/>
        </properties>
    </rule>

    <!--
      Check for usage of deprecated functions.
      UWAGA: minimum_supported_version to minimalna wersja WORDPRESSA (nie PHP).
      Motyw wymaga WP 6.2+ (patrz CLAUDE.md) - nizsza wartosc oslabia sniff (nie zlapie funkcji deprecated w 6.1-6.2).
    -->
    <rule ref="WordPress.WP.DeprecatedFunctions">
        <properties>
            <property name="minimum_supported_version"
                      value="6.2"/>
        </properties>
    </rule>

    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <properties>
            <property name="indent"
                      value="4"/>
            <property name="tabIndent"
                      value="false"/>
        </properties>
    </rule>

    <rule ref="PEAR.Functions.FunctionCallSignature">
        <properties>
            <property name="indent"
                      value="2"/>
        </properties>
    </rule>
    <rule ref="PEAR.Functions.FunctionCallSignature">
        <properties>
            <property name="requiredSpacesAfterOpen"
                      value="1"/>
            <property name="requiredSpacesBeforeClose"
                      value="1"/>
        </properties>
        <severity>0</severity>
    </rule>

    <rule ref="Generic.Files.LineEndings">
        <exclude name="Generic.Files.LineEndings.InvalidEOLChar"/>
    </rule>
    <rule ref="PEAR.Functions.FunctionCallSignature.SpaceAfterOpenBracket"/>
    <rule ref="PEAR.Functions.FunctionCallSignature.SpaceBeforeCloseBracket"/>
</ruleset>
