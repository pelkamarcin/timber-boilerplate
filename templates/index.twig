{% extends 'layouts/base.twig' %}

{% block content %}
    {% for post in posts %}
        {% include ['partials/tease-' ~ post.type ~ '.twig', 'partials/tease.twig'] %}
    {% endfor %}

    {% include 'partials/posts-pagination.twig' with {
        pagination: posts.pagination({
            show_all: false,
            mid_size: 3,
            end_size: 2
        }),
        before_after: true,
        numbered: true
    } %}
{% endblock %}
