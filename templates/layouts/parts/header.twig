<header class="c-header">
    <div class="container c-header__inner">

        <a href="{{ site.url }}">
            <img src="{{ theme.link }}/favicon.svg"
                 class="c-header__logo"
                 alt="{{ site.name }}"/>
        </a>
        <div class="c-mainmenu c-header__mainmenu" data-js="mainmenu">
            <nav class="c-mainmenu__nav">
                {% include 'partials/menu.twig' with {'menu': mainmenu.items, 'baseclass': 'c-mainmenu'} %}
            </nav>
        </div>
        <div class="c-mainmenu__burger-wrapper">
            <button class="hamburger hamburger--collapse c-mainmenu__hamburger" data-js="mainmenu-burger" type="button">
                <span class="hamburger-box"><span class="hamburger-inner"></span></span>
            </button>
        </div>
    </div>
</header>
