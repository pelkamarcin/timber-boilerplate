<!DOCTYPE html>
<html class="no-js is-page-loading" {{ site.language_attributes }}>
<head>
    <meta charset="{{ site.charset }}">
    <meta name="description"
          content="{{ site.description }}">
    {% set site_icon = fn('get_site_icon_url') %}
    {% if site_icon %}
        <link rel="icon" href="{{ site_icon }}"/>
    {% else %}
        <link rel="icon shortcut" href="{{ theme.link }}/favicon.png" type="image/vnd.microsoft.icon"/>
    {% endif %}
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">
    {% do action('get_header') %}
    {{ fn('wp_head') }}
    {% block head_append '' %}
</head>
