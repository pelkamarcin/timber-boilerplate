{% extends 'layouts/base.twig' %}

{% block content %}
    <article class="c-single c-post_{{ post.type }} s-textcontent" id="post-{{ post.id }}">
        {% include 'partials/thumbnail.twig' with {'post': post, 'size':'fullhd', 'classes': 'c-single__thumbnail'} %}
        <section class="c-single__content">
            <h1 class="c-single__heading">{{ post.title }}</h1>
            <p class="c-single__meta c-post-meta">
                <a href="{{ post.author.path }}" class="c-post-meta__author">{{ post.author.name }}</a>
                <span class="c-post-meta__divider">&bull;</span>
                <time class="c-post-meta__date" datetime="{{ post.date|date('Y-m-d H:i:s') }}">{{ post.date }}</time>
            </p>
            <div class="c-single__content">{{ post.content }}</div>
        </section>
        <section class="c-comments">
            {% if post.comments %}
                <h3 class="c-comments__heading">{{ __('Comments','sfy') }}</h3>
                <ul class="c-comments__list">
                    {% for cmt in post.comments %}
                        <li class="c-comments__item">
                            {% include 'partials/comment.twig' with {
                                comment: cmt
                            } %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if post.comment_status == 'closed' %}
                <p>{{ __('comments for this post are closed','sfy') }}</p>
            {% else %}
                {% include 'partials/comment-form.twig' %}
            {% endif %}
        </section>
    </article>
{% endblock %}
