<div class="c-comment-form">
    <h3 class="c-comment-form__heading">{{ __('Add comment','sfy') }}</h3>
    <form class="c-comment-form__form" method="post" action="{{ site.link ~ '/wp-comments-post.php' }}">
        {% if user %}
            <input type="hidden" name="email" value="{{ user.email }}"/>
            <input type="hidden" name="author" value="{{ user.name }}"/>
            <input type="hidden" name="url" value="{{ user.link }}"/>
        {% else %}
            <label class="c-comment-form__label">
                {{ __('Email','sfy') }}<br/>
                <input required name="email" class="c-comment-form__input" type="email" id="email"/>
            </label>
            <label class="c-comment-form__label">
                {{ __('Name','sfy') }}<br/>
                <input required name="author" class="c-comment-form__input" type="text"/>
            </label>
            <label class="c-comment-form__label">
                {{ __('Website','sfy') }}<br/>
                <input name="url" class="c-comment-form__input" type="url"/>
            </label>
        {% endif %}
        <label class="c-comment-form__label">
            {{ __('Comment','sfy') }}<br/>
            <textarea placeholder="{{ __('Leave a comment...','sfy') }}"
                      class="c-comment-form__input c-comment-form__input_textarea" name="comment" cols="60"
                      rows="3"></textarea>
        </label>
        <input name="comment_post_ID" value="{{ post.id }}" type="hidden"/>
        <input name="comment_parent" value="{{ comment.id|default('0') }}" type="hidden"/>
        <button type="submit" name="Submit" class="c-button c-comment-form__send">{{ __('Send','sfy') }}</button>
        <button type="reset" class="c-button c-comment-form__reset">{{ __('Cancel','sfy') }}</button>
        <p>{{ __('Your comment will be revised by the site if needed.','sfy') }}</p>
    </form>
</div>
