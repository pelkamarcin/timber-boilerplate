<article class="c-tease c-tease_{{ post.type }}" id="tease-{{ post.id }}">
    {% block content %}
        <a href="{{ post.link }}">{% include 'components/media/thumbnail.twig' with {'post': post, 'size':'square', 'classes': 'c-tease__thumbnail'} %}</a>
        <h2 class="c-tease__heading"><a href="{{ post.link }}">{{ post.title }}</a></h2>
        <p class="c-tease__excerpt">{{ post.excerpt({
                words: 15,
                read_more: __('Keep reading','sfy')
            }) }}</p>

    {% endblock %}
</article>
