<div class="c-comment" id="comment-{{ comment.id }}">
    <h5 class="c-comment__author">{{ comment.author.name }}</h5>
    <div class="c-comment__content">{{ comment.content|wpautop }}</div>

    <section class="c-comments c-comments_replies c-comment__replies">
        {% include 'partials/comment-form.twig' with {comment: comment} %}

        {% if post.comments %}
            <h4 class="c-comments__heading">{{ __('Replies','sfy') }}</h4>
            <ul class="c-comments__list">
                {% for cmt in comment.children %}
                    <li class="c-comments__item c-comments__item_reply">
                        {% include 'partials/comment.twig' with {
                            comment: cmt
                        } %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
</div>
